# Copy to .env for local/docker-compose use. Never commit the real .env.
ENVIRONMENT=production            # production | development | test
JWT_SECRET=                       # REQUIRED in production: random string, 32+ chars  (python -c "import secrets;print(secrets.token_urlsafe(48))")
ADMIN_PASSWORD=                   # REQUIRED in production: 12+ chars, initial password for user "admin"
POSTGRES_PASSWORD=                # docker-compose only
# DATABASE_URL=                   # defaults to SQLite in ./data. postgres:// and postgresql:// URLs are accepted.
ACCESS_TOKEN_MINUTES=60
ALLOWED_ORIGINS=                  # leave empty when the portal and API share one origin (the default setup)
MAX_UPLOAD_BYTES=15000000
INSTITUTION_CODE=PILOT
DEFAULT_INSTITUTION_NAME=CEDA Innovation Management Portal (Prototype)
DEFAULT_PROGRAMME_NAME=Innovation Challenge 2026

# Demo data: creates officer1 / committee1 / applicant1 (all with DEMO_PASSWORD) and one sample application.
SEED_DEMO=false
DEMO_PASSWORD=                    # 12+ chars; required when SEED_DEMO=true

# Optional AI commentary. Off unless an administrator also enables it in Settings.
OPENAI_API_KEY=
OPENAI_MODEL=                     # set to a model your account can use; AI is skipped if empty
OPENAI_TIMEOUT=45
